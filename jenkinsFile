pipeline {
    agent any

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== CHECKOUT : Recuperation du projet ==='
                git url: 'https://github.com/yessineamri2004-byte/JenkisTp2.git', branch: 'main'
            }
        }

        stage('Build') {
            steps {
                echo '=== BUILD : Construction du projet ==='
                bat 'echo Preparation du projet...'
                bat 'dir'
            }
        }

        stage('Test') {
            steps {
                echo '=== TEST : Verification du projet ==='
                bat 'git status'
                bat 'if exist index.html (echo Fichier index.html trouve) else (echo Fichier index.html introuvable)'
                sh 'grep -q "<html" index.html'
                sh 'grep -q "<h1>" index.html'
            }
        }

        stage('Deploy') {
            steps {
                echo '=== DEPLOY : Deploiement du projet ==='
                bat 'echo Le projet est pret pour le deploiement'
            }
        }
    }

    post {
        success {
            echo 'BUILD OK : Pipeline termine avec succes !'
        }

        failure {
            echo 'BUILD KO : Une erreur est survenue !'
        }
    }
}